graph TD
    A["📥 Incident Input<br/>(DisruptionIncident)"] --> B["🚪 Monitor Gate<br/>validate_disruption<br/>identify_affected_sites"]
    
    B -->|✓ Valid| C["📋 Blackboard<br/>(Shared State)"]
    B -->|✗ Invalid| D["❌ Rejected<br/>(Outcome: rejected)"]
    
    C --> E["📊 Incident Assessment<br/>(Monitor owns)<br/>write-once"]
    
    C --> F["⚡ Parallel Investigation"]
    
    F --> G["📦 InventoryAgent<br/>get_inventory<br/>calculate_stock_shortage"]
    F --> H["🏭 SupplierAgent<br/>find_alternative_suppliers<br/>check_supplier_capacity"]
    F --> I["🚚 RouteAgent<br/>get_available_routes<br/>calculate_route_delay"]
    
    G -->|owns| J["📊 inventory_findings<br/>(write-once,<br/>asyncio.Lock)"]
    H -->|owns| K["📊 supplier_findings<br/>(write-once,<br/>asyncio.Lock)"]
    I -->|owns| L["📊 route_findings<br/>(write-once,<br/>asyncio.Lock)"]
    
    J --> M["📋 Evidence Snapshot<br/>(AVAILABLE | UNKNOWN | FAILED)"]
    K --> M
    L --> M
    E --> M
    
    M --> N["🤔 CoordinatorAgent<br/>read_blackboard_evidence<br/>validate_mitigation_decision"]
    
    N -->|LLM proposal<br/>if available| O["🛡️ Guardrail Check<br/>(Citations valid?)"]
    N -->|deterministic| P["📋 Proposal Logic<br/>(REORDER | REROUTE<br/>| HOLD | UNKNOWN)"]
    
    O -->|✓ Pass| Q["✅ Decision Validation<br/>(Independent Gate)"]
    O -->|✗ Fail| P
    P --> Q
    
    Q -->|✓ Valid| R["✅ Outcome: decided<br/>or undetermined"]
    Q -->|✗ Invalid| S["❌ Outcome: failed"]
    
    R --> T["📢 MitigationResult<br/>decision + option_id<br/>justification + parties"]
    S --> T
    D --> T
    
    T --> U["📜 Persist JSONL<br/>(Append-only Log)<br/>Complete Trace"]
    
    U --> V["📤 IncidentResponse<br/>run_id, decision,<br/>evidence, trace,<br/>log_persisted"]
    
