# Copy to .env and fill in real values locally. Never commit .env.
#
# LLM provider: auto | gemini | openai | none
#   auto  -> gemini if GEMINI_API_KEY is set, else openai if OPENAI_API_KEY is set, else none
#   none  -> deterministic fallback only (labelled "deterministic_fallback"; no LLM is called)
LLM_PROVIDER=auto

# Gemini via Semantic Kernel GoogleAIChatCompletion (uses the google-genai SDK)
# Models: gemini-2.0-flash (recommended), gemini-1.5-flash, gemini-1.5-pro
# See scripts/list_models.py to query available models
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI via Semantic Kernel OpenAIChatCompletion
OPENAI_API_KEY=
OPENAI_MODEL_ID=gpt-4o-mini

# App settings
LOG_LEVEL=INFO
INCIDENT_LOG_PATH=logs/incident_runs.jsonl
AGENT_TIMEOUT_SECONDS=60
TOOL_RETRY_MAX_ATTEMPTS=3
TOOL_RETRY_DELAY_SECONDS=0.05
